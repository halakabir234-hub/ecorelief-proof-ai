VITE_NETWORK_ID=preprod
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
VITE_DEFAULT_CONTRACT=20ac3cceedeaf961aeccf79ae15e0f6d8ab29589921c5a7a71a111e7aa94c6d8
VITE_PROOF_SERVER_URL=https://zk-leaderboard-production.up.railway.app
VITE_ECORELIEF_NETWORK_ID=undeployed
VITE_ECORELIEF_CONTRACT_ADDRESS=5c480b972ec88ffc8af9584a3a81acbaeb9a1b9a6e1c28062b62bfcf85a0e8de

# Local "undeployed" network: no Lace configuration needed. EcoRelief
# connects to a real local wallet connector over WebSocket JSON-RPC
# (`npx midnight-wallet-cli serve --wallet ecorelief-demo --network undeployed`,
# default ws://localhost:9932) instead of Lace, and that connector reports
# the real local node (ws://localhost:9944), indexer (http/ws://localhost:8088)
# and proof server (http://localhost:6300) URLs itself via getConfiguration() —
# confirmed by direct RPC probe against the live server. Override the
# connector URL only if you run `midnight serve` on a non-default port:
# VITE_ECORELIEF_LOCAL_WALLET_WS_URL=ws://localhost:9932
